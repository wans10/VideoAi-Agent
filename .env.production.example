# Copy to .env.production, replace every placeholder, then run:
# docker compose --env-file .env.production up -d --build

# Compose-managed PostgreSQL. Set DATABASE_URL to an external Neon, Supabase,
# RDS, or other PostgreSQL URL to use it for the app and migration job instead.
POSTGRES_DB=maxvideoai
POSTGRES_USER=maxvideoai
POSTGRES_PASSWORD=replace-with-a-long-random-password
# DATABASE_URL=postgresql://user:password@managed-postgres.example.com:5432/maxvideoai?sslmode=require

NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_SITE_URL=https://app.example.com
HEALTHCHECK_TOKEN=replace-with-at-least-32-random-bytes

# Supabase authentication
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SITE_URL=https://app.example.com

# Object storage (S3 or Cloudflare R2's S3-compatible endpoint)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
ASSET_HOST_ALLOWLIST=

# Billing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=

# Core provider credentials
FAL_KEY=
FAL_API_KEY=
FAL_WEBHOOK_TOKEN=
FAL_POLL_TOKEN=
OPENAI_API_KEY=
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_SERVICE_ACCOUNT_JSON=
BYTEPLUS_ARK_API_KEY=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Operational secrets
CRON_SECRET=
MCP_ACQUISITION_SIGNING_SECRET=
MCP_TOPUP_HANDOFF_SECRET=
LOG_LEVEL=info
ENFORCE_HTTPS=true

# Required self-hosted worker authentication. Generate a unique random value.
CRON_SECRET=
STUDIO_VERCEL_WORKERS_ENABLED=true

# Seedance 2.5 video edit (v2v) routing.
# Canonical variable: SEEDANCE_2_5_EDIT_TRANSPORT (`modelark` or `las`; code default `las`).
# SEEDANCE_2_5_V2V_TRANSPORT is a legacy compatibility fallback only, read when SEEDANCE_2_5_EDIT_TRANSPORT is unset.
# Do not set it in new deployments.
#
# REQUIRED BEFORE DEPLOYING THIS MERGE (Keyvo production serves v2v on the ModelArk channel for all users, with
# SEEDANCE_2_5_BYTEPLUS_MODES=t2v,i2v,ref2v,v2v,extend): add BOTH variables to the production .env.production.
# Without SEEDANCE_2_5_MODELARK_EDIT_ENABLED=true every v2v execution is rejected with the error code
# BYTEPLUS_MODELARK_EDIT_EXECUTION_DISABLED (the gate is new in this upstream snapshot).
# - `modelark` channel needs SEEDANCE_2_5_MODELARK_EDIT_ENABLED=true.
# - `las` channel (NOT needed for this deployment; kept for reference) needs SEEDANCE_2_5_LAS_ENABLED=true
#   and an audited LAS price table (see docs/model-launch/seedance-2-5-las-edit.md).
SEEDANCE_2_5_EDIT_TRANSPORT=modelark
SEEDANCE_2_5_MODELARK_EDIT_ENABLED=true

# Studio timeline export launcher (AWS ECS Fargate). Required only when exports are enabled;
# see docs/deployment/studio-timeline-exports.md. Leave the credential pair empty to use the
# task/instance role; set both or neither.
# TIMELINE_EXPORT_ECS_CLUSTER=
# TIMELINE_EXPORT_ECS_TASK_DEFINITION=
# TIMELINE_EXPORT_ECS_REGION=
# TIMELINE_EXPORT_ECS_SUBNETS=
# TIMELINE_EXPORT_ECS_SECURITY_GROUP=
# TIMELINE_EXPORT_ECS_CONTAINER_NAME=worker
# TIMELINE_EXPORT_ECS_ASSIGN_PUBLIC_IP=ENABLED
# TIMELINE_EXPORT_ECS_ACCESS_KEY_ID=
# TIMELINE_EXPORT_ECS_SECRET_ACCESS_KEY=
