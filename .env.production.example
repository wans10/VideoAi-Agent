# Copy to .env.production next to docker-compose.1panel.yml and replace every placeholder.
# The web and db-migrate containers read it through env_file. Never commit the filled-in file.
#
# Image tag: the Actions workflow publishes ONLY the full 40-character commit SHA and never `latest`,
# while the compose file defaults IMAGE_TAG to `latest`. Set IMAGE_TAG to the exact commit SHA you
# deploy, in the place compose interpolates from (docker compose --env-file, or the project's .env).
# IMAGE_TAG=
# DOCKER_IMAGE_NAMESPACE=wans10

# ---------------------------------------------------------------------------------------------
# Required to start
# ---------------------------------------------------------------------------------------------
# External PostgreSQL 17 (the compose file has no database service). The migration job exits
# non-zero when this is missing and the web container then never starts.
# Do not send production traffic over the public internet with sslmode=disable: enable TLS on the
# database and use sslmode=require, or connect over a private network.
DATABASE_URL=postgresql://user:password@db.example.com:5432/keyvo?sslmode=require
# Optional direct (non-pooled) URL for maintenance scripts; same rules as DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# The container health check calls /api/health/db with this token; without it the container stays unhealthy.
HEALTHCHECK_TOKEN=replace-with-at-least-32-random-bytes
# Authenticates /api/cron/* routes and the self-hosted workers. Generate a unique random value.
CRON_SECRET=
# Random secret that hashes client IPs in the checkout guard (also the fallback secret for export estimates).
CHECKOUT_GUARD_HASH_SECRET=

NEXT_PUBLIC_API_BASE=/api
# Compiled into the browser bundle at build time; the workflow requires https://app.keyvo.cn.
NEXT_PUBLIC_SITE_URL=https://app.keyvo.cn
LOG_LEVEL=info
ENFORCE_HTTPS=true
STUDIO_VERCEL_WORKERS_ENABLED=true

# ---------------------------------------------------------------------------------------------
# Authentication (Supabase). The URL and anon key are ALSO compiled into the browser bundle at build
# time from the GitHub repository variables NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY;
# the values here must match them or the browser and the server talk to different projects.
# ---------------------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://auth.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SITE_URL=https://app.keyvo.cn
# Phone number + SMS code login (mainland +86 numbers). Compiled into the browser bundle at build time from
# the GitHub repository variable NEXT_PUBLIC_PHONE_LOGIN_ENABLED (Dockerfile build ARG); changing it here alone
# has no effect on a published image. Turn it on only after the GoTrue Send SMS hook works end to end:
# docs/deployment/phone-login-sms/README.md.
NEXT_PUBLIC_PHONE_LOGIN_ENABLED=false

# Currency is fixed to CNY by docker-compose.1panel.yml (DEFAULT_CURRENCY, ENABLED_CURRENCIES and the
# NEXT_PUBLIC_CUSTOMER_CURRENCY build argument); do not override it here.

# ---------------------------------------------------------------------------------------------
# Object storage (S3 with a CDN in front)
# ---------------------------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
ASSET_HOST_ALLOWLIST=

# ---------------------------------------------------------------------------------------------
# Payments: LLM Hub Pay (聚合易支付). Stripe is not used by Keyvo.
# ---------------------------------------------------------------------------------------------
LLMHUB_PAY_PID=
LLMHUB_PAY_MERCHANT_PRIVATE_KEY=
LLMHUB_PAY_PLATFORM_PUBLIC_KEY=

# ---------------------------------------------------------------------------------------------
# Model providers. The defaults of every provider flag are conservative (disabled or admin-only);
# a model is visible to users only after you switch it on explicitly.
# ---------------------------------------------------------------------------------------------
LLMHUB_API_KEY=

# Alibaba Cloud Model Studio (Wan 3, HappyHorse 1.1 video; Qwen Image). The code defaults to the
# mainland cn-beijing account: without a base URL it uses https://<WORKSPACE_ID>.cn-beijing.maas.aliyuncs.com
# when ALIBABA_MODEL_STUDIO_WORKSPACE_ID is set, else the public Beijing DashScope endpoint. Setting the
# workspace host explicitly below is preferred (the DashScope domain gets no new features after 2026-09-30).
# Keep ALIBABA_MODEL_STUDIO_FALLBACK_TO_FAL_ENABLED unset/false: Keyvo has no fal account.
ALIBABA_MODEL_STUDIO_API_KEY=
ALIBABA_MODEL_STUDIO_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com
ALIBABA_MODEL_STUDIO_REGION=cn-beijing
ALIBABA_MODEL_STUDIO_ENABLED=true
ALIBABA_MODEL_STUDIO_PUBLIC_ROUTING_ENABLED=true
ALIBABA_MODEL_STUDIO_ADMIN_ONLY=false
# Bailian (the same Model Studio account and gates) also hosts Kling 3.0 / 3.0 Omni / 3.0 Turbo and MiniMax-H3.
# Route order per vendor family, decided before any task exists: `bailian,direct` (default: Bailian first, the
# vendor's own API only after a definite pre-acceptance rejection), `direct,bailian`, or a single `bailian` /
# `direct` to disable the fallback. Unknown values fall back to the default. Activate the Kling and MiniMax model
# cards in the Bailian console (cn-beijing) first; until then every request pays one rejected round trip.
# Kling 3.0 Turbo's direct leg is plain kling-v3 (Kling's legacy API has no Turbo model).
KLING_ROUTE_ORDER=bailian,direct
MINIMAX_H3_ROUTE_ORDER=bailian,direct

# Volcengine Ark (mainland China). These values are also the code defaults; set them explicitly so a
# deployment never depends on a default. Model ids may also be account endpoint ids (ep-...).
BYTEPLUS_ARK_API_KEY=
BYTEPLUS_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
BYTEPLUS_ARK_REGION=cn-beijing
BYTEPLUS_ARK_ENABLED=true
BYTEPLUS_ARK_SEEDANCE_MODEL_ID=doubao-seedance-2-0-260128
BYTEPLUS_ARK_SEEDANCE_FAST_MODEL_ID=doubao-seedance-2-0-fast-260128
BYTEPLUS_ARK_SEEDANCE_MINI_MODEL_ID=doubao-seedance-2-0-mini-260615
BYTEPLUS_ARK_SEEDANCE_2_5_MODEL_ID=doubao-seedance-2-5-260628
BYTEPLUS_ARK_SEEDREAM_PRO_MODEL_ID=doubao-seedream-5-0-pro-260628
BYTEPLUS_ARK_SEEDREAM_FLASH_MODEL_ID=doubao-seedream-5-0-flash-260915
# Seedream 5.0 Lite and Seedance 1.5 Pro are retired on Keyvo; their ids are only read by historical jobs.
# BYTEPLUS_ARK_SEEDREAM_MODEL_ID=doubao-seedream-5-0-260128
# Ark allows one concurrent Seedance 2.0 4K task per account (RPM 15). Raise only if Volcengine grants more.
# SEEDANCE_2_4K_MAX_CONCURRENCY=1

# Seed Audio 1.0 voice over (Volcengine speech console key, NOT the Ark key). Off unless enabled.
# SEED_AUDIO_ENABLED=false
# SEED_AUDIO_API_KEY=
# SEED_AUDIO_API_BASE=https://openspeech.bytedance.com
# SEED_AUDIO_MODEL=seed-audio-1.0

# Google Vertex AI (Veo). Keep the regional endpoint settings from docs/deployment/vertex-regions.md.
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_SERVICE_ACCOUNT_JSON=
GOOGLE_VERTEX_VEO_ENABLED=true

# Optional providers
OPENAI_API_KEY=
FAL_KEY=
FAL_WEBHOOK_TOKEN=
FAL_POLL_TOKEN=

# ---------------------------------------------------------------------------------------------
# Seedance 2.5 video editing (v2v): leave at the upstream defaults.
# Seedance 2.5 v2v has no price unless a reviewed manual tariff is active. Do not list `v2v` in
# SEEDANCE_2_5_BYTEPLUS_MODES, and do not set SEEDANCE_2_5_EDIT_TRANSPORT,
# SEEDANCE_2_5_MODELARK_EDIT_ENABLED or the legacy SEEDANCE_2_5_V2V_TRANSPORT. Activating the
# customer tariff state to price it makes every other model fail to quote.
# The other Seedance models (2.0, Fast, Mini) price their v2v mode by rule and need nothing here.
# ---------------------------------------------------------------------------------------------
SEEDANCE_2_5_BYTEPLUS_MODES=t2v,i2v,ref2v,extend

# ---------------------------------------------------------------------------------------------
# Checkout CAPTCHA: leave every Turnstile variable unset (NEXT_PUBLIC_TURNSTILE_SITE_KEY,
# TURNSTILE_SECRET_KEY, TURNSTILE_*, CHECKOUT_CAPTCHA_MODE). A partial configuration refuses every
# top-up with 403. See docs/deployment/keyvo-turnstile.md.
# ---------------------------------------------------------------------------------------------

# ---------------------------------------------------------------------------------------------
# MCP (AI assistant connections): off unless you serve it on its OWN host name.
# Never set MCP_API_HOST to the web site's host: the site is then treated as the MCP protocol host
# and robots.txt answers "Disallow: /" for the whole site, which blocks search indexing.
# Set these only together, on a dedicated host such as mcp.example.com that routes to this app.
# ---------------------------------------------------------------------------------------------
# MCP_API_HOST=
# MCP_RESOURCE_URL=https://<MCP_API_HOST>/mcp
# MCP_ACQUISITION_SIGNING_SECRET=
# MCP_TOPUP_HANDOFF_SECRET=

# ---------------------------------------------------------------------------------------------
# Studio timeline export launcher (AWS ECS Fargate). Required only when exports are enabled;
# see docs/deployment/studio-timeline-exports.md. Leave the credential pair empty to use the
# task/instance role; set both or neither.
# ---------------------------------------------------------------------------------------------
# TIMELINE_EXPORT_ECS_CLUSTER=
# TIMELINE_EXPORT_ECS_TASK_DEFINITION=
# TIMELINE_EXPORT_ECS_REGION=
# TIMELINE_EXPORT_ECS_SUBNETS=
# TIMELINE_EXPORT_ECS_SECURITY_GROUP=
# TIMELINE_EXPORT_ECS_CONTAINER_NAME=worker
# TIMELINE_EXPORT_ECS_ASSIGN_PUBLIC_IP=ENABLED
# TIMELINE_EXPORT_ECS_ACCESS_KEY_ID=
# TIMELINE_EXPORT_ECS_SECRET_ACCESS_KEY=
