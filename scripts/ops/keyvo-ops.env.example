# Copy to /etc/keyvo-ops.env (chmod 600, owner root). Never commit the real file.
# The monitor reads it from the path in KEYVO_OPS_ENV (default /etc/keyvo-ops.env).
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
# anon (public) key of the self-hosted Supabase, used only for /auth/v1/health
SUPABASE_ANON_KEY=
# must equal CRON_SECRET of the app container
OPS_CRON_SECRET=
# optional: http://<host>:8787/healthz of the SMS hook if reachable from this host
SMS_HOOK_HEALTH_URL=
# optional overrides (defaults in brackets)
# APP_BASE_URL=https://app.keyvo.cn
# SUPABASE_URL=https://supabase.keyvo.cn
# TLS_HOSTS=app.keyvo.cn,supabase.keyvo.cn,keyvo.cn
# TLS_WARN_DAYS=14
# SLOW_MS=5000
# FAILURES_BEFORE_ALERT=2
# REMIND_MINUTES=60
# KEYVO_OPS_STATE=/var/lib/keyvo-ops/state.json
# OPS_HEARTBEAT=1          # daily "monitor alive" message at OPS_HEARTBEAT_HOUR (Beijing time, default 9)
# OPS_HOST_LABEL=aliyun-relay
